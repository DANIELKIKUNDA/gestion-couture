# Configuration conseillee pour generer l'APK/AAB destine au Play Store.
# Copier ce fichier vers .env.android, puis remplacer par le backend HTTPS de production.
# Ne pas utiliser localhost, ni l'adresse IP du PC, ni un backend staging http pour une version publique.
VITE_API_BASE_URL=https://api.ton-domaine-production.com/api
