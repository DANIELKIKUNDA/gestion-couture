# Copie ce fichier vers .env.android puis remplace par l'URL publique du backend.
# Important: dans l'application Android, /api ne peut pas pointer vers ton backend local.
# Pour le Play Store, pars de .env.android.production.example et utilise uniquement une URL HTTPS de production.
VITE_API_BASE_URL=https://api.ton-domaine.com/api
